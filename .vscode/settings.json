{
    "[slang]": {
        "editor.formatOnPaste": false,
        "editor.formatOnSave": false,
        "editor.formatOnType": false
    },
    "files.exclude": {
        "**/*.bkp": false,
        "**/*.lscache": false,
        "**/*.spv": false,
        "**/.DS_Store": false,
        "**/.git": false,
        "**/.hg": false,
        "**/.svn": false,
        "**/bin": false,
        "**/CVS": false,
        "**/external": false,
        "**/obj": false,
        "**/TestResults": false,
        "**/Thumbs.db": false,
        ".coverage": false,
        "BenchmarkDotNet.Artifacts": false
    },
    // "lldb.showDisassembly": "never",
    "lldb.suppressMissingSourceFiles": true,
    "lldb.library": "/usr/lib64/liblldb.so",
}
