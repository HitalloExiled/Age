{

    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Playground",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/source/Age.Playground/bin/Debug/net10.0/linux-x64/Age.Playground",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false,
            "justMyCode": true,
            "symbolOptions": {
                "searchMicrosoftSymbolServer": false,
                "searchNuGetOrgSymbolServer": false,
            },
            "enableStepFiltering": true,
            "windows": {
                "program": "${workspaceFolder}/source/Age.Playground/bin/Debug/net10.0/win-x64/Age.Playground.exe"
            },
            "linux": {
                "env": {
                    "VK_INSTANCE_LAYERS": "VK_LAYER_KHRONOS_validation",
                    "WAYLAND_DEBUG": "0",
                }
            }
        },
        {
            "name": "Launch StoryBook",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/source/Age.StoryBook/bin/Debug/net10.0/linux-x64/Age.StoryBook",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false,
            "justMyCode": true,
            "symbolOptions": {
                "searchMicrosoftSymbolServer": false,
                "searchNuGetOrgSymbolServer": false,
            },
            "enableStepFiltering": true,
            "windows": {
                "program": "${workspaceFolder}/source/Age.StoryBook/bin/Debug/net10.0/win-x64/Age.StoryBook.exe"
            },
            "linux": {
                "env": {
                    "VK_INSTANCE_LAYERS": "VK_LAYER_KHRONOS_validation",
                    "WAYLAND_DEBUG": "1",
                }
            }
        },
    ]
}
